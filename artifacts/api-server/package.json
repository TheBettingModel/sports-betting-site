{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "pipeline:once": "tsx ./scripts/run-cloud-pipeline-once.ts",
    "model:train:v4-core-241": "tsx ./scripts/train-rolling-score-v4-241.ts",
    "model:acquire-train:v4-core-243": "tsx ./scripts/acquire-train-v4-243.ts",
    "model:train:nfl-v4-243b": "tsx ./scripts/train-nfl-v4-243b.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "audit:mlb-pitchers": "node ./scripts/audit-mlb-pitchers.mjs",
    "replay:mlb-v4": "tsx ./scripts/mlb-v4-historical-replay.mjs",
    "replay:mlb-v4-1-diagnosis": "node ./scripts/mlb-v4-1-run-model-diagnosis.mjs",
    "build:mlb-historical-pit": "tsx ./scripts/mlb-historical-pit-foundation.ts",
    "audit:mlb-historical-pit": "tsx ./scripts/mlb-historical-pit-audit.ts",
    "guard:mlb-historical-pit": "tsx ./scripts/mlb-historical-install-guards.ts",
    "collect:mlb-historical-completion": "tsx ./scripts/mlb-historical-completion-collect.ts",
    "build:mlb-historical-completion": "tsx ./scripts/mlb-historical-completion-foundation.ts",
    "audit:mlb-historical-completion": "tsx ./scripts/mlb-historical-completion-audit.ts",
    "collect:mlb-historical-pitcher-bullpen": "tsx ./scripts/mlb-historical-pitcher-bullpen-collect.ts",
    "build:mlb-historical-pitcher-bullpen": "tsx ./scripts/mlb-historical-pitcher-bullpen-materialize.ts",
    "audit:mlb-historical-pitcher-bullpen": "tsx ./scripts/mlb-historical-pitcher-bullpen-audit.ts",
    "audit:mlb-historical-pitcher-bullpen:independent": "tsx ./scripts/mlb-historical-pitcher-bullpen-independent-audit.ts",
    "report:mlb-pit": "tsx ./scripts/mlb-pit-research-report.ts",
    "report:mlb-advanced-data": "tsx ./scripts/mlb-advanced-data-report.ts",
    "train:mlb-v4-expected-runs": "tsx ./scripts/train-mlb-v4-expected-runs.ts",
    "train:mlb-v4-moneyline-237": "tsx ./scripts/train-mlb-v4-moneyline-237.ts",
    "evaluate:mlb-v4-expected-runs:oos": "tsx ./scripts/evaluate-mlb-v4-expected-runs-oos.ts",
    "audit:mlb-v4-expected-runs": "tsx ./scripts/audit-mlb-v4-expected-runs.ts",
    "report:mlb-v4-expected-runs": "tsx ./scripts/report-mlb-v4-expected-runs.ts",
    "report:mlb-v4-candidates": "tsx ./scripts/report-mlb-v4-candidate-diagnostics.ts",
    "freeze:mlb-224c1": "tsx ./scripts/freeze-mlb-224c1-research-state.ts",
    "audit:mlb-224c1-root-cause": "tsx ./scripts/audit-mlb-224c1-root-cause.ts",
    "capture:mlb-224c1-starters": "MLB_STARTER_EVIDENCE_224C_MANUAL=1 tsx ./scripts/mlb-starter-evidence-224c-manual.ts",
    "report:mlb-224c1": "tsx ./scripts/report-mlb-224c1.ts",
    "report:mlb-224c1b": "NODE_ENV=development tsx ./scripts/report-mlb-224c1b.ts",
    "schema:mlb-v4:dev": "NODE_ENV=development pnpm --filter @workspace/db run push",
    "schema:guarded-serving:dev": "NODE_ENV=development pnpm --filter @workspace/db run push && tsx ./scripts/install-guarded-serving-guards.ts",
    "verify:guarded-serving-mutations:dev": "NODE_ENV=development tsx ./scripts/verify-guarded-serving-mutations.ts"
  },
  "dependencies": {
    "@replit/connectors-sdk": "*",
    "@replit/revenuecat-sdk": "*",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "expo-server-sdk": "^6.1.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "jose": "^6.2.3",
    "node-cron": "^4.6.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^7.2.1",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "thread-stream": "3.1.0",
    "vitest": "^4.1.10"
  }
}
