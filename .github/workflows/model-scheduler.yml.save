name: Model Scheduler

on:
  schedule:
    # Morning refresh - 9:00 AM ET
    - cron: "0 13 * * *"

    # Afternoon refresh - 1:00 PM ET
    - cron: "0 17 * * *"

    # Final refresh - 5:00 PM ET
    - cron: "0 21 * * *"

    # Overnight grading - 3:00 AM ET
    - cron: "0 7 * * *"

  workflow_dispatch:

jobs:
  run-scheduler:
    runs-on: ubuntu-latest

    steps:
      - name: Determine action
        id: action
        run: |
          HOUR=$(date -u +"%H")

          if [ "$HOUR" = "07" ]; then
            echo "mode=grade" >> $GITHUB_OUTPUT
          else
            echo "mode=refresh" >> $GITHUB_OUTPUT
          fi

      - name: Refresh MLB model
        if: steps.action.outputs.mode == 'refresh'
        run: |
          curl -X POST https://sports-betting-backend-ecic.onrender.com/refresh/mlb

      - name: Refresh NBA model
        if: steps.action.outputs.mode == 'refresh'
        run: |
          curl -X POST https://sports-betting-backend-ecic.onrender.com/refresh/nba

      - name: Grade MLB history
        if: steps.action.outputs.mode == 'grade'
        run: |
          curl -X POST https://sports-betting-backend-ecic.onrender.com/grade/mlb/history

      - name: Grade NBA history
        if: steps.action.outputs.mode == 'grade'
        run: |
          curl -X POST https://sports-betting-backend-ecic.onrender.com/grade/nba/history

      - name: Check performance
        run: |
          curl -s https://sports-betting-backend-ecic.onrender.com/model/performance
