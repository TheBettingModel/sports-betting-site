+  def ensure_package_reference_in_project(project, url, requirement)
+    pkg_class = Xcodeproj::Project::Object::XCRemoteSwiftPackageReference
+    return if project.root_object.package_references.any? { |p|
+      p.class == pkg_class && p.repositoryURL == url
+    }
+    pkg = project.new(pkg_class)
+    pkg.repositoryURL = url
+    pkg.requirement = requirement
+    project.root_object.package_references << pkg
+    log " Also registered package reference in user project: #{url}"
+  end
