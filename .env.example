# Runtime
NODE_ENV=production
PORT=8080
TRUST_PROXY_HOPS=1
CORS_ALLOWED_ORIGINS=https://admin.example.com
PUBLIC_API_URL=https://api.example.com

# Database
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Authentication
CLERK_PUBLISHABLE_KEY=replace_me
CLERK_SECRET_KEY=replace_me
CLERK_PROXY_URL=https://api.example.com/api/clerk
SESSION_SECRET=replace_me

# Providers
ODDS_API_KEY=replace_me
CFBD_API_KEY=replace_me
SLACK_LIVE_API_KEY=replace_me
REVENUECAT_WEBHOOK_SECRET=replace_me

# Operations
MASTER_API_KEY=replace_me
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=America/New_York
PUBLICATION_ENABLED=false
MLB_MODEL_MODE=v1
NCAAF_MODEL_MODE=legacy

# Frontend/mobile build-time public values
VITE_API_BASE_URL=https://api.example.com
VITE_CLERK_PUBLISHABLE_KEY=replace_me
VITE_CLERK_PROXY_URL=https://api.example.com/api/clerk
EXPO_PUBLIC_API_URL=https://api.example.com
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=replace_me
EXPO_PUBLIC_CLERK_PROXY_URL=https://api.example.com/api/clerk
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=replace_me
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=replace_me
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=replace_me
EXPO_PUBLIC_ADMIN_USER_IDS=replace_me
EXPO_PUBLIC_ADMIN_EMAILS=replace_me
EXPO_PUBLIC_DOMAIN=api.example.com